+# slime-opd-multi-teacher: one teacher weight set per sample source.
+def _teacher_source(teacher_tag: str) -> str:
+    """"teacher::retool" -> "retool". Only valid for the per-source tags."""
+    return teacher_tag.split("::", 1)[1]
+
+
+def _teachers_present_in_batch(teacher_tags: list[str], rollout_data: RolloutBatch) -> list[str]:
+    """Drop teachers that have no sample to score on this rank.
+
+    With one teacher (--opd-teacher-load) there is nothing to decide. With
+    --opd-teacher-loads, a rank whose partition happens to hold a single source
+    -- which is what a run with one source, or a source-ordered batch, produces
+    -- should not pay for the other teachers' forwards.
+    """
+    if teacher_tags == ["teacher"] or not teacher_tags:
+        return teacher_tags
+    source_names = rollout_data.get("source_names")
+    if source_names is None:
+        raise ValueError(
+            "--opd-teacher-loads routes each sample to its own teacher by source, but this "
+            "rollout carries no 'source_names'. The rollout must set "
+            "Sample.metadata['source_name'] on every sample (see slime.utils.data.get_source)."
+        )
+    present = set(source_names)
+    return [tag for tag in teacher_tags if _teacher_source(tag) in present]
+
+
+def _source_forward_schedule(source_names, total_lengths, source, max_tokens_per_mbs, micro_batch_size):
+    """One teacher's forward: its source's samples (indices into the rank's batch, in the batch's order)
+    and their micro-batches (lists of positions in that index list, each position in exactly one),
+    packed as build_dp_schedule packs a step (slime/utils/dp_schedule.py): first fit under the token
+    cap with the dynamic batch size, an oversized sample alone; fixed chunks of micro_batch_size
+    otherwise. Deterministic, so the tensor-parallel ranks of a data-parallel rank agree."""
+    from slime.utils.seqlen_balancing import first_fit_pack
+
+    indices = [i for i, name in enumerate(source_names) if name == source]
+    if max_tokens_per_mbs is not None:
+        micro_batches = first_fit_pack([total_lengths[i] for i in indices], max_tokens_per_mbs)
+    else:
+        micro_batches = [
+            list(range(a, min(a + micro_batch_size, len(indices)))) for a in range(0, len(indices), micro_batch_size)
+        ]
+    assert sorted(j for mbs in micro_batches for j in mbs) == list(range(len(indices))), "every sample once"
+    return indices, micro_batches
+
+
+def _scatter_rows(values, indices, n):
+    """values[j], computed for the sample at indices[j], back at that index of a list of n; None elsewhere."""
+    assert len(values) == len(indices), (len(values), len(indices))
+    out = [None] * n
+    for j, i in enumerate(indices):
+        out[i] = values[j]
+    return out
+
+
+def _route_teacher_log_probs(rollout_data: RolloutBatch, teacher_tags: list[str]) -> None:
+    """Pick each sample's own teacher's log-probs into rollout_data["teacher_log_probs"].
+
+    Every "{tag}_log_probs" list is index-aligned with rollout_data: a teacher's forward over its
+    own source's samples is scattered back to the batch's indices, None at the other sources'
+    (_forward_teachers), so this is a per-index choice and never a reordering. A None at a
+    sample's own teacher is refused: that sample was not scored by it.
+    """
+    keys = {tag: f"{tag}_log_probs" for tag in teacher_tags}
+    if not all(key in rollout_data for key in keys.values()):
+        # Not the last pipeline stage: there are no log-probs here, and
+        # compute_advantages_and_returns returns before it would want them.
+        return
+
+    source_names = rollout_data["source_names"]
+    by_source = {_teacher_source(tag): rollout_data[key] for tag, key in keys.items()}
+    routed = []
+    for index, source in enumerate(source_names):
+        if source not in by_source:
+            raise ValueError(
+                f"Sample {index} has source {source!r}, which has no teacher in "
+                f"--opd-teacher-loads (teachers: {sorted(by_source)}). Every source in the "
+                "rollout needs one, otherwise that sample has no distillation target."
+            )
+        value = by_source[source][index]
+        if value is None:
+            raise ValueError(
+                f"Sample {index} (source {source!r}) was not scored by its teacher: the per-source "
+                "forward schedule (_source_forward_schedule) and the batch disagree."
+            )
+        routed.append(value)
+    rollout_data["teacher_log_probs"] = routed
+
+    # The per-teacher lists are what each teacher thought of EVERY sample,
+    # including the ones it is not the teacher for. Keeping them would put
+    # meaningless cross-domain log-probs into the rollout metrics, which log
+    # every list-of-tensor key they find. Drop everything the teacher forwards
+    # stored, not just log_probs, so an added output (entropy) cannot leak.
+    for tag in teacher_tags:
+        for key in [k for k in list(rollout_data) if k.startswith(f"{tag}_")]:
+            del rollout_data[key]
+
