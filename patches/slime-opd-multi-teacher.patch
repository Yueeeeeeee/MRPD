+def _parse_teacher_map(text: str, flag: str) -> dict:
+    """Parse a source->value map from a command line, in either spelling.
+
+    Two spellings, because one of them has to survive Ray's entrypoint. Ray
+    joins the entrypoint into a single string, and whether the quotes around a
+    JSON value are stripped before argparse sees it depends on that join: a run
+    reached argparse holding a value that still carried its outer single
+    quotes, which json.loads rejects at character 0 with a message that says
+    nothing about quoting.
+
+      retool=/ckpt/a,search-r1=/ckpt/b     no quotes, braces or spaces at all
+      {"retool": "/ckpt/a", ...}           JSON, for driving slime directly
+
+    Surrounding quotes are stripped before either is tried, so a value that
+    does arrive still wrapped is read rather than rejected. Errors quote the
+    raw value back, because the failure is almost always in the quoting.
+    """
+    raw = (text or "").strip()
+    for quote in ("'", '"'):
+        if len(raw) >= 2 and raw.startswith(quote) and raw.endswith(quote):
+            raw = raw[1:-1].strip()
+    if not raw:
+        raise ValueError(f"{flag} is empty. Received: {text!r}")
+
+    if raw.startswith("{"):
+        try:
+            parsed = json.loads(raw)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"{flag} is not valid JSON ({e}). Received: {text!r}") from e
+        if not isinstance(parsed, dict) or not parsed:
+            raise ValueError(f"{flag} must be a non-empty JSON object. Received: {text!r}")
+        return parsed
+
+    parsed = {}
+    for item in raw.split(","):
+        item = item.strip()
+        if not item:
+            continue
+        if "=" not in item:
+            raise ValueError(
+                f"{flag} entry {item!r} has no '='. Expected source=value pairs separated by "
+                f"commas, e.g. retool=/ckpt/a,search-r1=/ckpt/b. Received: {text!r}"
+            )
+        name, _, value = item.partition("=")
+        name, value = name.strip(), value.strip()
+        if not name or not value:
+            raise ValueError(f"{flag} entry {item!r} has an empty side. Received: {text!r}")
+        parsed[name] = value
+    if not parsed:
+        raise ValueError(f"{flag} parsed to nothing. Received: {text!r}")
+    return parsed
+
+
